# Copy to .env or run sudo bash install.sh. Never commit your filled .env.
APP_DOMAIN=lookup.example.com
ACME_EMAIL=you@example.com
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
# * = any website; or exact origins separated by commas, without trailing /.
ALLOWED_ORIGINS=*
# npm start values; Docker Compose overrides these appropriately.
PORT=3000
HOST=127.0.0.1
SESSION_FILE=./data/bot.session
TRUST_PROXY_HOPS=0
